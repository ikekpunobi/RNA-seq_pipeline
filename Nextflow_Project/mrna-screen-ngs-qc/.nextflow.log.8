    download "$url2" "${run}_2.fastq.gz"
  else
    : > ${run}_2.fastq.gz
  fi
  
  if [ -n "\${md51:-}" ]; then
    got=\$(md5 -q ${run}_1.fastq.gz)
    [ "\$got" = "\$md51" ] || { echo "MD5 mismatch for ${run}_1.fastq.gz" >&2; exit 1; }
